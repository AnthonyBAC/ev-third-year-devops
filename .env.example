# Copia este archivo a .env y completa los valores para correr el stack local:
#   cp .env.example .env && docker compose up -d --build
#
# En el deploy a EC2 estos valores vienen de GitHub Secrets, no de este archivo.

# Usuario de Docker Hub (prefijo de las imagenes back-ventas / back-despachos)
DOCKER_USERNAME=tu_usuario_dockerhub

# Host de la base de datos (EC2 del tier de datos).
# En EC2 = IP privada de la instancia db. En local = host.docker.internal o la IP donde corra MySQL.
DB_HOST=172.31.20.253

# Credenciales de la base de datos (deben coincidir con las de la EC2 db)
MYSQL_USER=appuser
MYSQL_PASSWORD=cambia_esta_appuser
